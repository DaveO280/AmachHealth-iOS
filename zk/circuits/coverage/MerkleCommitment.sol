pragma solidity ^0.8.24;

// MerkleCommitment.sol
// Amach Health ZK — Phase 5
//
// Extends the existing AmachAttestation contract with:
//   1. commitGenesisRoot() — anchor the genesis Merkle root on-chain
//   2. verifyCoverageProof() — verify a Groth16 coverage proof on-chain
//
// The Groth16 verifier (CoverageVerifier) is generated by snarkJS:
//   snarkjs zkey export solidityverifier build/coverage/coverage_final.zkey CoverageVerifier.sol
//
// Deployment:
//   1. Deploy CoverageVerifier.sol (generated by snarkJS)
//   2. Deploy MerkleCommitment.sol with the CoverageVerifier address
//   3. Grant MERKLE_ADMIN_ROLE to the iOS backend wallet
//
// Network: ZKsync Era Sepolia (chainId 300)

/// @dev Minimal interface for the snarkJS-generated Groth16 verifier.
interface ICoverageVerifier {
    function verifyProof(
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[4] calldata input
    ) external view returns (bool);
}

contract MerkleCommitment {

    // ── Events ──────────────────────────────────────────────────

    event GenesisRootCommitted(
        address indexed wallet,
        bytes32 root,
        uint32 startDayId,
        uint32 endDayId,
        uint32 leafCount,
        uint8 rootType,
        uint8 syncType,
        uint256 timestamp
    );

    event MerkleRootUpdated(
        address indexed wallet,
        bytes32 root,
        bytes32 leavesDigest,
        uint32 maxDayId,
        bool initial,
        uint256 timestamp
    );

    event CoverageProofVerified(
        address indexed wallet,
        bytes32 root,
        uint32 startDayId,
        uint32 endDayId,
        uint32 minDays,
        bool valid
    );

    // ── State ────────────────────────────────────────────────────

    /// @dev The Groth16 verifier contract (generated by snarkJS)
    ICoverageVerifier public immutable coverageVerifier;

    /// @dev wallet address → genesis root commitment
    struct RootCommitment {
        bytes32 root;
        bytes32 prevRoot;     // zero for genesis
        uint32 startDayId;
        uint32 endDayId;
        uint32 leafCount;
        uint8 rootType;       // 0=genesis, 1=weekly, 2=historical
        uint8 syncType;       // 0=live, 1=enrichment
        uint256 committedAt;
    }

    mapping(address => RootCommitment) public genesisRoots;
    mapping(address => bool) public hasGenesisRoot;

    /// @dev Lane A — append-only canonical leaf binding (keccak chain over (dayId, leafHash)).
    mapping(address => bytes32) public leavesDigest;
    /// @dev Highest dayId included in `leavesDigest` for this wallet (strict append: new days must be greater).
    mapping(address => uint32) public maxCommittedDayId;

    // ── Constructor ───────────────────────────────────────────────

    constructor(address _coverageVerifier) {
        require(_coverageVerifier != address(0), "Verifier address required");
        coverageVerifier = ICoverageVerifier(_coverageVerifier);
    }

    // ── Root Commitment ───────────────────────────────────────────

    /**
     * @notice Commit a genesis Merkle root for the caller's wallet.
     * @dev Only callable once per wallet (genesis is immutable).
     *      For subsequent root updates (weekly sync), use a separate updateRoot() function.
     *
     * @param root       The Merkle root (32 bytes)
     * @param prevRoot   Previous root (zero bytes32 for genesis)
     * @param startDayId First day_id covered (days since 2024-01-01)
     * @param endDayId   Last day_id covered
     * @param leafCount  Number of real leaves (not padded)
     * @param rootType   0=genesis, 1=weekly, 2=historical
     * @param syncType   0=live, 1=enrichment
     */
    function commitGenesisRoot(
        bytes32 root,
        bytes32 prevRoot,
        uint32 startDayId,
        uint32 endDayId,
        uint32 leafCount,
        uint8 rootType,
        uint8 syncType
    ) external {
        require(root != bytes32(0), "Root cannot be zero");
        require(endDayId >= startDayId, "Invalid day range");
        require(leafCount > 0, "Leaf count must be positive");
        require(!hasGenesisRoot[msg.sender], "Genesis root already committed");

        genesisRoots[msg.sender] = RootCommitment({
            root: root,
            prevRoot: prevRoot,
            startDayId: startDayId,
            endDayId: endDayId,
            leafCount: leafCount,
            rootType: rootType,
            syncType: syncType,
            committedAt: block.timestamp
        });

        hasGenesisRoot[msg.sender] = true;

        emit GenesisRootCommitted(
            msg.sender,
            root,
            startDayId,
            endDayId,
            leafCount,
            rootType,
            syncType,
            block.timestamp
        );
    }

    /**
     * @notice Read the committed genesis root for a wallet.
     */
    function getGenesisRoot(address wallet) external view returns (RootCommitment memory) {
        require(hasGenesisRoot[wallet], "No genesis root committed for this wallet");
        return genesisRoots[wallet];
    }

    // ── Coverage Proof Verification ───────────────────────────────

    /**
     * @notice Verify a Groth16 coverage proof on-chain.
     * @dev Delegates to the snarkJS-generated CoverageVerifier contract.
     *
     * Public signals layout (must match circuit's main component):
     *   publicSignals[0] = root
     *   publicSignals[1] = start_day_id
     *   publicSignals[2] = end_day_id
     *   publicSignals[3] = min_days
     *
     * @param a    Proof component A (G1 point)
     * @param b    Proof component B (G2 point)
     * @param c    Proof component C (G1 point)
     * @param publicSignals [root, start_day_id, end_day_id, min_days]
     * @return valid True if the proof is valid
     */
    function verifyCoverageProof(
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[4] calldata publicSignals
    ) external view returns (bool valid) {
        valid = coverageVerifier.verifyProof(a, b, c, publicSignals);
        return valid;
    }

    /**
     * @notice Verify a coverage proof AND check that the root matches
     *         the caller's committed genesis root.
     * @dev This is the higher-trust version — proves the coverage is
     *      about the caller's own committed dataset.
     */
    function verifyCoverageProofForSelf(
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[4] calldata publicSignals
    ) external returns (bool valid) {
        require(hasGenesisRoot[msg.sender], "No genesis root committed");

        // Public signal[0] must be the caller's committed root
        bytes32 claimedRoot = bytes32(publicSignals[0]);
        require(
            claimedRoot == genesisRoots[msg.sender].root,
            "Proof root does not match committed genesis root"
        );

        valid = coverageVerifier.verifyProof(a, b, c, publicSignals);

        emit CoverageProofVerified(
            msg.sender,
            claimedRoot,
            uint32(publicSignals[1]),  // start_day_id
            uint32(publicSignals[2]),  // end_day_id
            uint32(publicSignals[3]),  // min_days
            valid
        );

        return valid;
    }

    // ── Lane A: append-only leaf digest + Merkle root ─────────────────

    /// @notice Fold (dayId, leafHash) pairs into a running digest (must match off-chain / API).
    function _foldLeafPairs(
        bytes32 seed,
        uint32[] calldata dayIds,
        bytes32[] calldata leafHashes
    ) internal pure returns (bytes32) {
        require(dayIds.length == leafHashes.length, "Length mismatch");
        bytes32 h = seed;
        for (uint256 i = 0; i < dayIds.length; i++) {
            h = keccak256(abi.encodePacked(h, dayIds[i], leafHashes[i]));
        }
        return h;
    }

    /**
     * @notice Commit or update the Merkle root with an append-only leaf digest chain.
     * @dev Initial commit: `!hasGenesisRoot` — folds all (dayId, leafHash) from seed 0.
     *      Update: each `dayIds[i]` must be strictly greater than `maxCommittedDayId[msg.sender]`
     *      (requires sorted `dayIds`); digest is folded from previous `leavesDigest`.
     */
    function commitMerkleRootWithLeaves(
        bytes32 root,
        uint32 startDayId,
        uint32 endDayId,
        uint32 leafCount,
        uint8 rootType,
        uint8 syncType,
        uint32[] calldata dayIds,
        bytes32[] calldata leafHashes
    ) external {
        require(root != bytes32(0), "Root cannot be zero");
        require(endDayId >= startDayId, "Invalid day range");
        require(leafCount > 0, "Leaf count must be positive");
        require(dayIds.length == leafHashes.length, "Array length mismatch");
        require(dayIds.length > 0, "Empty leaf list");

        for (uint256 i = 1; i < dayIds.length; i++) {
            require(dayIds[i] > dayIds[i - 1], "dayIds must be sorted strictly increasing");
        }

        bytes32 newDigest;
        uint32 newMaxDay = dayIds[dayIds.length - 1];
        bool initial = !hasGenesisRoot[msg.sender];
        /// @dev Legacy `commitGenesisRoot` left Lane A fields unset (both zero). Backfill digest once.
        bool legacyLaneABackfill = hasGenesisRoot[msg.sender]
            && leavesDigest[msg.sender] == bytes32(0)
            && maxCommittedDayId[msg.sender] == 0;

        if (initial || legacyLaneABackfill) {
            require(dayIds.length == uint256(leafCount), "Initial commit: dayIds must cover all leaves");
            newDigest = _foldLeafPairs(bytes32(0), dayIds, leafHashes);
            maxCommittedDayId[msg.sender] = newMaxDay;
            if (initial) {
                hasGenesisRoot[msg.sender] = true;
            }
        } else {
            require(
                dayIds[0] > maxCommittedDayId[msg.sender],
                "Append-only: first new day must exceed maxCommittedDayId"
            );
            newDigest = _foldLeafPairs(leavesDigest[msg.sender], dayIds, leafHashes);
            if (newMaxDay > maxCommittedDayId[msg.sender]) {
                maxCommittedDayId[msg.sender] = newMaxDay;
            }
        }

        leavesDigest[msg.sender] = newDigest;

        bytes32 previousCommittedRoot = genesisRoots[msg.sender].root;

        genesisRoots[msg.sender] = RootCommitment({
            root: root,
            prevRoot: initial ? bytes32(0) : previousCommittedRoot,
            startDayId: startDayId,
            endDayId: endDayId,
            leafCount: leafCount,
            rootType: rootType,
            syncType: syncType,
            committedAt: block.timestamp
        });

        emit GenesisRootCommitted(
            msg.sender,
            root,
            startDayId,
            endDayId,
            leafCount,
            rootType,
            syncType,
            block.timestamp
        );
        emit MerkleRootUpdated(
            msg.sender,
            root,
            newDigest,
            maxCommittedDayId[msg.sender],
            initial || legacyLaneABackfill,
            block.timestamp
        );
    }
}
